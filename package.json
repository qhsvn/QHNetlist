{
  "name": "netlist",
  "version": "0.1.0",
  "description": "Netlist — thiết kế mạch điện tử trực quan, mô phỏng SPICE, tích hợp AI",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "web": "vite",
    "build": "tsc -p . && vite build && node scripts/build-electron.mjs",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "typecheck": "tsc -p .",
    "dist": "npm run build && npx --yes electron-builder --win nsis"
  },
  "author": "Netlist",
  "license": "UNLICENSED",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "avr8js": "^0.21.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "electron": "^45.2.3",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "type": "module",
  "private": true,
  "build": {
    "appId": "app.netlist.desktop",
    "productName": "Netlist",
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "directories": {
      "output": "release"
    }
  }
}
